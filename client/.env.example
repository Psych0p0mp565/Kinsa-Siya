# Copy to `.env.local` for local overrides (not committed).

# Public game API (Socket.IO). Leave unset on localhost so Vite proxies /socket.io to port 3001.
# For Cloudflare Pages / any static host: set this in the host's build env (no trailing slash), e.g.:
# VITE_SERVER_URL=https://kinsa-siya.onrender.com

# Optional WebRTC ICE servers JSON (use TURN when players are on different networks / strict NAT).
# VITE_ICE_SERVERS_JSON=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
